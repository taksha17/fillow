# Copy to .env — never commit .env
#
# Hybrid (see HYBRID.md): GitHub Actions runs fillow online (discover + score)
# with no secrets. This machine runs fillow offline (PDFs, apply, Gmail).
# FILLLOW_SCORE_ONLY=true is set by Actions; locally use: fillow evaluate --score-only

# NVIDIA NIM (answers + optional score verify) — local / offline half only
NVIDIA_API_KEY=

# Runtime (also in config/profile.yaml; env wins)
MIN_MATCH_SCORE=78
MAX_APPLIES_PER_RUN=3
MAX_TAILOR_PER_RUN=12
ENRICH_PROFILES=false
DRY_RUN=true
REVIEW_MODE=false

# Optional — public GitHub API rate limit for resume enrich
GITHUB_TOKEN=

# Optional LLM fallbacks (used only if NVIDIA_API_KEY is unset or fails)
GROQ_API_KEY=
OPENAI_API_KEY=

# Gmail IMAP — Agent 3 OTP + Agent 4 reply-watch
# https://myaccount.google.com/apppasswords
GMAIL_IMAP_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Optional hosted dashboard (fillow cf setup)
FILLLOW_SYNC_URL=
FILLLOW_SYNC_TOKEN=

# Optional secondary sync target (D1 remains the canonical hosted index)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# check them all at once: fillow auth
